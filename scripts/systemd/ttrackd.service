[Unit]
Description=ttrack session recording collector (root-only central store)
Documentation=man:ttrack(1)
After=network.target

[Service]
Type=simple
ExecStart=/usr/libexec/ttrackd
Environment=TTRACK_CONFIG=/etc/ttrack/ttrack.conf
Restart=on-failure
RestartSec=2
# The daemon must run as root to own /var/lib/ttrack and read user-local
# spool files during startup ingest.
User=root
# Hardening: it only needs its socket, the central store, and user home spools.
LogsDirectory=ttrack
LogsDirectoryMode=0750
ProtectSystem=full
ReadWritePaths=/var/lib/ttrack /var/log/ttrack /var/run
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
