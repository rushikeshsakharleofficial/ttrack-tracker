[Unit]
Description=Percona Terminal Session Recorder Daemon
Documentation=https://github.com/percona/percona-monitoring-plugins
After=network.target
Requires=trackterm-recd.socket

[Service]
Type=notify
ExecStart=/usr/libexec/trackterm-recd -c /etc/trackterm-rec/recd.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5s
TimeoutStopSec=30s
WatchdogSec=60s

# Run as root to write to /var/lib/trackterm-rec (owned root:trackterm-audit)
User=root
Group=root

# Hardening
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/trackterm-rec /run/trackterm-rec
PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE CAP_SETUID CAP_SETGID
AmbientCapabilities=
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
