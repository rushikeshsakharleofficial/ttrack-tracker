# PAM session recording snippet for sshd.
# Add to /etc/pam.d/sshd AFTER the pam_loginuid.so line:
#
#   session    required     pam_loginuid.so
#   session    optional     pam_record.so service=sshd   ← add this
#
# Use 'optional' during initial deployment; promote to 'required' post-validation.
#
# RHEL 9 example:
#   grep -n loginuid /etc/pam.d/sshd
#   # Insert after that line number using sed or a text editor.
#
# Debian 12 example (sshd includes common-session):
#   Append after the @include common-session line.

session    optional     pam_record.so service=sshd
