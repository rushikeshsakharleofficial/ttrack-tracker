# PAM session recording snippet for sudo and sudo-i.
# Add to /etc/pam.d/sudo:
#
# session    optional     pam_record.so service=sudo
#
# Add to /etc/pam.d/sudo-i (RHEL 9 only; Debian 12 may not have this file):
#
# session    optional     pam_record.so service=sudo-i

session    optional     pam_record.so service=sudo
