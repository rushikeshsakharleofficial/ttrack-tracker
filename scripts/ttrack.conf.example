# ttrack runtime configuration
# File: /etc/ttrack/ttrack.conf  (override path: TTRACK_CONFIG env var)
# Env vars always override this file (TTRACKD_SOCK, TTRACK_CENTRAL_DIR, etc.)
# Restart ttrackd after editing: systemctl restart ttrackd

# Unix socket path the ttrackd daemon listens on.
socket_path = /run/ttrackd.sock

# Root-only directory where encrypted session recordings are stored.
central_dir = /var/lib/ttrack

# Path to the at-rest encryption key.
# Relative paths are joined with central_dir; empty = <central_dir>/.ttrack.key
key_file = .ttrack.key

# Seconds to wait when connecting to ttrackd (float, e.g. 0.5 or 2).
dial_timeout_sec = 1

# Milliseconds between stdin EOF Ctrl-D and force-closing the PTY master.
# Increase if bash takes longer to exit gracefully on your system.
eof_grace_ms = 500

# Maximum bytes stored per ansible task stdout/stderr output.
ansible_output_cap = 8192

# PTY read buffer size in bytes (minimum 4096). Larger = fewer syscalls on
# high-throughput sessions; smaller = lower per-session memory usage.
scroll_buffer = 32768
