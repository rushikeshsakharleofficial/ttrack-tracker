# Allowed real shells for trackterm-rec shim.
# Installed to /etc/trackterm-rec/shells.allow
# One shell path per line. Lines starting with # are comments.
# The shim validates pw_shell against this list before exec.
# If the file is absent, pw_shell is trusted as-is.

/bin/bash
/bin/sh
/bin/zsh
/bin/ksh
/usr/bin/bash
/usr/bin/zsh
/usr/bin/ksh
