#!/usr/bin/make -f
# Debian rules file — used by dpkg-buildpackage on Debian/Ubuntu hosts.

export DH_VERBOSE=1
export HAVE_SYSTEMD=1

%:
	dh $@

override_dh_auto_build:
	$(MAKE) HAVE_SYSTEMD=1

override_dh_auto_install:
	$(MAKE) install DESTDIR=$(CURDIR)/debian/pmp-rec PREFIX=/usr
	# Debian uses lib/x86_64-linux-gnu/security for PAM modules
	install -d $(CURDIR)/debian/pmp-rec/usr/lib/x86_64-linux-gnu/security
	mv $(CURDIR)/debian/pmp-rec/usr/lib64/security/pam_record.so \
	   $(CURDIR)/debian/pmp-rec/usr/lib/x86_64-linux-gnu/security/pam_record.so
	rm -rf $(CURDIR)/debian/pmp-rec/usr/lib64 2>/dev/null || true

override_dh_auto_clean:
	$(MAKE) clean

override_dh_auto_test:
	$(MAKE) tests
